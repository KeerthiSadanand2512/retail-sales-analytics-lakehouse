{
  "datasets": [
    {
      "name": "bc4b4b60",
      "displayName": "Sales Summary",
      "queryLines": [
        "SELECT\n",
        "    currency,\n",
        "    SUM(CASE WHEN quantity > 0 THEN line_value ELSE 0 END) AS gross_sales,\n",
        "    SUM(CASE WHEN quantity < 0 THEN -line_value ELSE 0 END) AS return_value,\n",
        "    SUM(line_value) AS net_sales,\n",
        "    COUNT(DISTINCT CASE WHEN quantity > 0 THEN invoice_id END) AS sale_orders\n",
        "FROM workspace.retail_learning.retail_silver\n",
        "WHERE eligible\n",
        "GROUP BY currency;"
      ]
    },
    {
      "name": "514ce4a3",
      "displayName": "Monthly Sales",
      "queryLines": [
        "SELECT\n",
        "    CAST(date_trunc('MONTH', transaction_date) AS DATE) AS month,\n",
        "    currency,\n",
        "    SUM(gross_sales) AS gross_sales,\n",
        "    SUM(return_value) AS return_value,\n",
        "    SUM(net_sales) AS net_sales\n",
        "FROM workspace.retail_learning.retail_gold_daily\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 1;"
      ]
    },
    {
      "name": "d676ac7c",
      "displayName": "Top Merchandise",
      "queryLines": [
        "SELECT\n",
        "    product_id,\n",
        "    currency,\n",
        "    net_sales\n",
        "FROM workspace.retail_learning.retail_gold_product\n",
        "WHERE product_id NOT IN ('DOT', 'POST')\n",
        "ORDER BY net_sales DESC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "8eee5791",
      "displayName": "Customer Summary",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS identified_customers,\n",
        "    SUM(CASE WHEN sale_orders >= 2 THEN 1 ELSE 0 END) AS repeat_customers,\n",
        "    ROUND(\n",
        "        100.0 * SUM(CASE WHEN sale_orders >= 2 THEN 1 ELSE 0 END)\n",
        "        / NULLIF(COUNT(*), 0),\n",
        "        2\n",
        "    ) AS repeat_customer_pct\n",
        "FROM workspace.retail_learning.retail_gold_customer;"
      ]
    }
  ],
